# Local development environment — copy to .env.local and source it.
#
#   cp .env.local.example .env.local
#   set -a; . ./.env.local; set +a
#
# Every value below points at a container from docker-compose.yml EXCEPT the AWS
# credentials, which are real. That split is ADR-019's whole point: model calls go
# to Bedrock in every environment, so local development is cheap but not free and
# not offline.
#
# .env.local is gitignored. Never put real credentials in this example file.

# ── real AWS, consumed locally ────────────────────────────────────────────────
# Bedrock only. Get these however you normally do (SSO, a profile, exported keys);
# boto3's default chain is honoured, so AWS_PROFILE works instead of keys.
AWS_REGION=eu-west-2
AWS_DEFAULT_REGION=eu-west-2
# AWS_PROFILE=your-sso-profile
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ── models ───────────────────────────────────────────────────────────────────
# Verified by calling them in eu-west-2. agent/models/verified_models is the
# authoritative list; every anthropic.* id except opus-4-6 fails on our accounts,
# two of them on billing rather than permissions.
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
BEDROCK_FAST_MODEL=amazon.nova-lite-v1:0
# Floor matters for reasoning models: they spend output budget thinking before
# they answer, so too small a value returns a successful call with no reply.
AGENT_MAX_TOKENS=1024

# ── container services ───────────────────────────────────────────────────────
# Same variables the cluster sets, pointed at localhost. Swapping environments is
# a config change and never a code change (ADR-019's portability rule).
QDRANT_URL=http://localhost:6333

# ── web search (SearXNG via MCP) ─────────────────────────────────────────────
# Search is an MCP plug-in: the harness runs `npx mcp-searxng`, which queries the
# SearXNG instance at SEARXNG_URL. Point this at the local container in dev, or
# the cluster's SearXNG in prod — same tool, no code change. This is the BASE URL
# (no /search path; the MCP server appends it). 8088, not 8080 — 8080 is commonly
# taken on a developer machine. Match SEARXNG_PORT in docker-compose.yml.
SEARXNG_URL=http://localhost:8088

# MinIO speaks the S3 API. boto3 reads AWS_ENDPOINT_URL_S3 natively, so
# agent/filesystem/workspace.py talks to MinIO with no code change — which is the
# object-storage seam ADR-019 requires, actually working.
WORKSPACE_BUCKET=eaf-workspace-local
AWS_ENDPOINT_URL_S3=http://localhost:9000
# S3-ONLY credentials, for MinIO. These exist because boto3 has no per-service
# credential resolution — one set of keys serves every client in the process — so
# with a single pair either Bedrock fails for want of real credentials or MinIO
# fails with InvalidAccessKeyId. agent/filesystem/workspace.py uses these for S3
# and leaves everything else on the default chain.
#
# Leave them UNSET in the cluster: unset means the default chain, so IRSA applies
# and no static credential exists anywhere.
S3_ACCESS_KEY_ID=eaflocal
S3_SECRET_ACCESS_KEY=eaflocal-dev-password

# ── page fetching ────────────────────────────────────────────────────────────
# `direct` extracts article markdown with httpx + trafilatura — no browser, no
# service, no spend. It does NOT run JavaScript, so a client-rendered page comes
# back thin; for those, run a real Firecrawl and switch this to `firecrawl`.
# The cluster uses `firecrawl`. Same tools either way — this one var decides.
FETCH_BACKEND=direct
# Only read when FETCH_BACKEND=firecrawl:
# FIRECRAWL_URL=http://localhost:3002
# FIRECRAWL_API_KEY=internal

# ── optional ─────────────────────────────────────────────────────────────────
# AGENT_PROVIDER=echo        # no model calls at all — offline UI work, zero spend
# AGENT_SKILLS_DIR=skills
# CONTEXT_COMPACT_AFTER=40
# CONTEXT_KEEP_RECENT=10
# SESSION_TOKEN_BUDGET=100000

# ── LangSmith tracing (optional) ─────────────────────────────────────────────
# LangGraph/LangChain auto-trace every model call, tool call, and sub-agent to
# LangSmith when these are set — no code change needed. Get a key at
# https://smith.langchain.com. The dashboard /api/config reports whether it is on.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=ls__your_key_here
# LANGSMITH_PROJECT=enterprise-agent-framework
