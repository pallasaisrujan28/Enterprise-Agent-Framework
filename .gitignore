# Obsidian per-user workspace state. Opening docs/vault as a vault creates this,
# and it churns on every pane move — it is not a shared artifact.
# Note: .obsidian/ is NOT the vault content. The vault content is the generated
# markdown under docs/vault, which IS committed (see .kiro/steering/obsidian-vault.md).
.obsidian/
.obsidian-*/

# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Build-check artefacts. uv.lock IS committed — it pins exact resolved versions
# and hashes, which is the whole point of having a lock.
coverage.xml
.coverage
test-reports/

# Local environment — never commit secrets
.env
.env.*
!.env.example
# The local-stack template. `.env.*` above would have swallowed it, and a
# committed example that is silently ignored is the same as no example at all —
# the next person clones the repo and has nothing to copy.
!.env.local.example

# MCP server config holds API tokens in its env block. Steering and specs under
# .kiro ARE committed; this one file must not be.
.kiro/settings/mcp.json

# OAuth credentials and cached tokens (Google Calendar, etc.). These live under
# $EAF_HOME (default ~/.eaf, outside the repo) — but guard against an in-repo
# EAF_HOME accidentally committing a client secret or a refresh token.
.eaf/
credentials.json
*token*.json
google-token.json

# Playwright MCP session artefacts (console logs, snapshots, screenshots).
.playwright-mcp/
