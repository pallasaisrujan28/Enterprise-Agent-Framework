# AWS Bedrock Configuration for Narrative Generation
# Copy this file to .env and fill in your actual AWS credentials

# AWS Access Key ID (required for AWS Bedrock)
AWS_ACCESS_KEY_ID=your_aws_access_key_here

# AWS Secret Access Key (required for AWS Bedrock)
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# AWS Region (updated to us-west-2 for inference profiles)
AWS_DEFAULT_REGION=us-west-2

# Bedrock Model Configuration (using inference profiles)
BEDROCK_MODEL_ID=arn:aws:bedrock:us-west-2:866647877267:inference-profile/global.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_REGION=us-west-2

# Quality threshold for persona generation (optional)
DEFAULT_QUALITY_THRESHOLD=0.3

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace the placeholder values with your actual AWS credentials
# 3. Ensure your AWS account has access to Amazon Bedrock inference profiles
# 4. Make sure the inference profiles are enabled in your AWS Bedrock console
# 5. Restart the backend server after setting up credentials